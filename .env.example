# AgriSmart AI — Environment Variables
# Copy this file to .env and fill in the values

# Gemini API Key (for Farmer Assistant and Agentic Advisor)
# Get a free key from: https://aistudio.google.com
# Optional — app will use rule-based fallback if not provided
GEMINI_API_KEY=

# Weather location (default: Ahmedabad, Gujarat)
DEFAULT_LATITUDE=23.0225
DEFAULT_LONGITUDE=72.5714

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend settings
NEXT_PUBLIC_API_URL=http://localhost:8000
